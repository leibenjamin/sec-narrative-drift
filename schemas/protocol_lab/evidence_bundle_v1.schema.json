{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "artifact_status": "complete",
  "$id": "protocol_lab/evidence_bundle_v1.schema.json",
  "title": "Protocol Lab Evidence Bundle v1",
  "type": "object",
  "required": [
    "artifact_status",
    "artifact_schema_id",
    "evidence_bundle_id",
    "run_request_id",
    "fixture_id",
    "protocol_id",
    "model_profile_id",
    "runner_binding_id",
    "items",
    "notes"
  ],
  "properties": {
    "artifact_status": {
      "type": "string",
      "enum": [
        "complete",
        "scaffolded",
        "pending",
        "blocked",
        "not_attempted"
      ]
    },
    "artifact_status_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_schema_id": {
      "const": "evidence_bundle_v1"
    },
    "evidence_bundle_id": {
      "type": "string"
    },
    "run_request_id": {
      "type": "string"
    },
    "fixture_id": {
      "type": "string"
    },
    "protocol_id": {
      "type": "string"
    },
    "model_profile_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "year_label",
          "paragraph_id",
          "quote_text",
          "source_locator"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "year_label": {
            "type": "string"
          },
          "paragraph_id": {
            "type": "string"
          },
          "quote_text": {
            "type": "string"
          },
          "source_locator": {
            "type": "object",
            "required": [
              "accession_number",
              "filing_date",
              "form_type",
              "section_id",
              "source_path",
              "char_start",
              "char_end"
            ],
            "properties": {
              "accession_number": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "filing_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "form_type": {
                "type": "string"
              },
              "section_id": {
                "type": "string"
              },
              "source_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "char_start": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "char_end": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "short_note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runner_binding_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
