{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "artifact_status": "complete",
  "$id": "protocol_lab/experimental/bounded_contrast_map_v0.schema.json",
  "title": "Bounded Contrast Map Response v0",
  "type": "object",
  "required": [
    "bounded_contrast_map",
    "evidence_bundle"
  ],
  "properties": {
    "bounded_contrast_map": {
      "$ref": "#/$defs/boundedContrastMapArtifact"
    },
    "evidence_bundle": {
      "$ref": "../evidence_bundle_v1.schema.json"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "contrastRow": {
      "type": "object",
      "required": [
        "axis",
        "what_changed",
        "what_stayed_the_same",
        "why_not_to_overcall_it",
        "why_it_still_matters"
      ],
      "properties": {
        "axis": {
          "type": "string",
          "minLength": 1
        },
        "what_changed": {
          "type": "string",
          "minLength": 1
        },
        "what_stayed_the_same": {
          "type": "string",
          "minLength": 1
        },
        "why_not_to_overcall_it": {
          "type": "string",
          "minLength": 1
        },
        "why_it_still_matters": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "boundedContrastMapArtifact": {
      "type": "object",
      "required": [
        "fixture_id",
        "rows",
        "best_used_when",
        "stop_note",
        "tempting_bad_read",
        "evidence_ids"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/contrastRow"
          }
        },
        "best_used_when": {
          "type": "string",
          "minLength": 1
        },
        "stop_note": {
          "type": "string",
          "minLength": 1
        },
        "tempting_bad_read": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
