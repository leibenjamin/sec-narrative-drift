{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "artifact_status": "complete",
  "$id": "protocol_lab/experimental/decision_relevance_ledger_v1.schema.json",
  "title": "Decision Relevance Ledger Response v1",
  "type": "object",
  "required": [
    "decision_relevance_ledger",
    "evidence_bundle"
  ],
  "properties": {
    "decision_relevance_ledger": {
      "$ref": "#/$defs/decisionRelevanceLedgerArtifact"
    },
    "evidence_bundle": {
      "$ref": "../evidence_bundle_v1.schema.json"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "readerOfRecord": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "const": "general_business_reader"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ledgerEntry": {
      "type": "object",
      "required": [
        "change_anchor",
        "change_type",
        "decision_relevance",
        "public_claim_effect",
        "why_it_matters",
        "why_not_to_overclaim",
        "evidence_ids"
      ],
      "properties": {
        "change_anchor": {
          "type": "string",
          "minLength": 1
        },
        "change_type": {
          "type": "string",
          "enum": [
            "new",
            "sharpened",
            "reframed",
            "reused",
            "carryforward"
          ]
        },
        "decision_relevance": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "public_claim_effect": {
          "type": "string",
          "enum": [
            "broadens",
            "narrows",
            "clarifies",
            "no_change"
          ]
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "why_not_to_overclaim": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "overallVerdict": {
      "type": "object",
      "required": [
        "most_decision_relevant_shift",
        "what_remains_background",
        "boundary_note"
      ],
      "properties": {
        "most_decision_relevant_shift": {
          "type": "string",
          "minLength": 1
        },
        "what_remains_background": {
          "type": "string",
          "minLength": 1
        },
        "boundary_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "decisionRelevanceLedgerArtifact": {
      "type": "object",
      "required": [
        "fixture_id",
        "reader_of_record",
        "entries",
        "overall_verdict"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "minLength": 1
        },
        "reader_of_record": {
          "$ref": "#/$defs/readerOfRecord"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ledgerEntry"
          }
        },
        "overall_verdict": {
          "$ref": "#/$defs/overallVerdict"
        }
      },
      "additionalProperties": false
    }
  }
}
