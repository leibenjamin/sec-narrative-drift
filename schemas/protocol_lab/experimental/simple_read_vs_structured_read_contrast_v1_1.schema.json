{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "artifact_status": "complete",
  "$id": "protocol_lab/experimental/simple_read_vs_structured_read_contrast_v1_1.schema.json",
  "title": "Simple Read vs Structured Read Adjudication Response v1.1",
  "type": "object",
  "required": [
    "simple_vs_structured_adjudication",
    "evidence_bundle"
  ],
  "properties": {
    "simple_vs_structured_adjudication": {
      "$ref": "#/$defs/adjudicationArtifact"
    },
    "evidence_bundle": {
      "$ref": "../evidence_bundle_v1.schema.json"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": [
        "workflow_id",
        "artifact_ref"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "adjudicationArtifact": {
      "type": "object",
      "required": [
        "fixture_id",
        "simple_read_source",
        "structured_read_source",
        "source_consistency_verdict",
        "source_consistency_check",
        "contrast_verdict",
        "what_simple_gets_right",
        "what_structure_adds",
        "allowed_public_claim_delta",
        "most_likely_misread_if_using_only_simple_read",
        "why_the_difference_matters",
        "stop_note"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "minLength": 1
        },
        "simple_read_source": {
          "$ref": "#/$defs/sourceRef"
        },
        "structured_read_source": {
          "$ref": "#/$defs/sourceRef"
        },
        "source_consistency_verdict": {
          "type": "string",
          "enum": [
            "consistent",
            "minor_mismatch",
            "major_mismatch",
            "incomparable"
          ]
        },
        "source_consistency_check": {
          "type": "string",
          "minLength": 1
        },
        "contrast_verdict": {
          "type": "string",
          "enum": [
            "simple_is_enough",
            "structured_adds_material_value",
            "mixed",
            "structure_overkill"
          ]
        },
        "what_simple_gets_right": {
          "type": "string",
          "minLength": 1
        },
        "what_structure_adds": {
          "type": "string",
          "minLength": 1
        },
        "allowed_public_claim_delta": {
          "type": "string",
          "enum": [
            "no_change",
            "clearer",
            "narrower",
            "broader"
          ]
        },
        "most_likely_misread_if_using_only_simple_read": {
          "type": "string",
          "minLength": 1
        },
        "why_the_difference_matters": {
          "type": "string",
          "minLength": 1
        },
        "stop_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
