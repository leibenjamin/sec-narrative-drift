{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "artifact_status": "complete",
  "$id": "protocol_lab/experimental/simple_read_vs_structured_read_contrast_v1.schema.json",
  "title": "Simple Read vs Structured Read Contrast Response v1",
  "type": "object",
  "required": [
    "simple_vs_structured",
    "evidence_bundle"
  ],
  "properties": {
    "simple_vs_structured": {
      "$ref": "#/$defs/simpleVsStructuredArtifact"
    },
    "evidence_bundle": {
      "$ref": "../evidence_bundle_v1.schema.json"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "readArtifact": {
      "type": "object",
      "required": [
        "summary_one_liner",
        "main_claim",
        "evidence_ids"
      ],
      "properties": {
        "summary_one_liner": {
          "type": "string",
          "minLength": 1
        },
        "main_claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "simpleVsStructuredArtifact": {
      "type": "object",
      "required": [
        "fixture_id",
        "simple_read",
        "structured_read",
        "contrast_verdict",
        "what_simple_gets_right",
        "what_structure_adds",
        "why_the_difference_matters",
        "stop_note"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "minLength": 1
        },
        "simple_read": {
          "$ref": "#/$defs/readArtifact"
        },
        "structured_read": {
          "$ref": "#/$defs/readArtifact"
        },
        "contrast_verdict": {
          "type": "string",
          "enum": [
            "simple_is_enough",
            "structured_adds_material_value",
            "mixed",
            "structure_overkill"
          ]
        },
        "what_simple_gets_right": {
          "type": "string",
          "minLength": 1
        },
        "what_structure_adds": {
          "type": "string",
          "minLength": 1
        },
        "why_the_difference_matters": {
          "type": "string",
          "minLength": 1
        },
        "stop_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
